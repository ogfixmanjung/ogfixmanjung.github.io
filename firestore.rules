rules_version = '2';

// Peraturan keselamatan database OGFIX.
// GANTIKAN email di bawah dengan email owner kedai (huruf kecil), kemudian
// salin keseluruhan fail ini ke Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmail() {
      return 'EMAIL_OWNER@gmail.com';
    }

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isOwner() {
      return signedIn() && myEmail() == ownerEmail();
    }

    // Staff mesti: (1) sahkan email, (2) emailnya ditambah oleh owner
    function isApprovedStaff() {
      return signedIn() &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/config/staff) &&
        myEmail() in get(/databases/$(database)/documents/config/staff).data.emails;
    }

    function isStaff() {
      return isOwner() || isApprovedStaff();
    }

    // Log perubahan: setiap kemaskini mesti tambah TEPAT satu catatan baru atas
    // nama pengguna sendiri, dan catatan lama tidak boleh dipadam / diubah.
    function logAppendedByMe() {
      let oldLog = resource.data.get('log', []);
      let newLog = request.resource.data.get('log', []);
      return newLog.size() == oldLog.size() + 1 &&
        newLog[0:oldLog.size()] == oldLog &&
        newLog[oldLog.size()].by == myEmail();
    }

    function newJobLogOk() {
      let newLog = request.resource.data.get('log', []);
      return newLog.size() >= 1 && newLog[newLog.size() - 1].by == myEmail();
    }

    // Senarai staff: hanya owner boleh ubah
    match /config/staff {
      allow read: if isStaff();
      allow create, update: if isOwner() && request.resource.data.owner == ownerEmail();
      allow delete: if false;
    }

    // Tetapan kedai: staff boleh baca, owner sahaja boleh ubah
    match /config/shop {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    // Rekod device: staff boleh tambah & kemaskini (dengan log), owner sahaja boleh padam
    match /jobs/{id} {
      allow read: if isStaff();
      allow create: if isOwner() || (isStaff() && newJobLogOk());
      allow update: if isOwner() || (isStaff() && logAppendedByMe());
      allow delete: if isOwner();
    }

    match /photos/{id} {
      allow read, create, update, delete: if isStaff();
    }

    // Resit pelanggan (link pendek): sesiapa yang ada link boleh baca SATU resit itu,
    // tetapi tidak boleh senaraikan resit lain. Tiada passcode/gambar/tandatangan di sini.
    match /receipts/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isStaff();
      allow delete: if isOwner();
    }

    match /counters/{id} {
      allow read, write: if isStaff();
    }

    // Selain di atas: tiada akses
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
