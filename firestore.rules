rules_version = '2';

// Peraturan keselamatan database OGFIX.
// GANTIKAN email di bawah dengan email owner kedai (huruf kecil), kemudian
// salin keseluruhan fail ini ke Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmail() {
      return 'EMAIL_OWNER@gmail.com';
    }

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isOwner() {
      return signedIn() && request.auth.token.email.lower() == ownerEmail();
    }

    function isStaff() {
      return isOwner() || (
        signedIn() &&
        exists(/databases/$(database)/documents/config/staff) &&
        request.auth.token.email.lower() in get(/databases/$(database)/documents/config/staff).data.emails
      );
    }

    // Senarai staff: hanya owner boleh ubah
    match /config/staff {
      allow read: if isStaff();
      allow create, update: if isOwner() && request.resource.data.owner == ownerEmail();
      allow delete: if false;
    }

    // Tetapan kedai: staff boleh baca, owner sahaja boleh ubah
    match /config/shop {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    // Rekod device: staff boleh tambah & kemaskini, owner sahaja boleh padam
    match /jobs/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isOwner();
    }

    match /photos/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isStaff();
    }

    match /counters/{id} {
      allow read, write: if isStaff();
    }

    // Selain di atas: tiada akses
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
